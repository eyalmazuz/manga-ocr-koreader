<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Manga OCR worker third-party licenses</title>
  <style>
    body {
      font-family: sans-serif;
      line-height: 1.45;
      margin: 2rem auto;
      max-width: 70rem;
      padding: 0 1rem;
    }
    pre {
      border: 1px solid #bbb;
      overflow-x: auto;
      padding: 1rem;
      white-space: pre-wrap;
    }
  </style>
</head>
<body>
  <main>
    <h1>Rust dependency licenses</h1>
    <p>
      This file lists the licenses and preserved notices for the Rust
      dependencies included in Manga OCR worker release binaries. It is
      generated from <code>backend/Cargo.lock</code> with
      <code>cargo-about 0.9.1</code>; do not edit it manually.
    </p>

    <h2>License overview</h2>
    <ul>
      {{#each overview}}
      <li>{{name}} ({{count}})</li>
      {{/each}}
    </ul>

    <h2>License texts and packages</h2>
    {{#each licenses}}
    <section>
      <h3>{{name}}</h3>
      <p>Used by:</p>
      <ul>
        {{#each used_by}}
        <li data-cargo-package="{{crate.name}} {{crate.version}}">
          <a href="{{#if crate.repository}}{{crate.repository}}{{else}}https://crates.io/crates/{{crate.name}}{{/if}}">
            {{crate.name}} {{crate.version}}
          </a>
        </li>
        {{/each}}
      </ul>
      <pre>{{text}}</pre>
    </section>
    {{/each}}
  </main>
</body>
</html>
